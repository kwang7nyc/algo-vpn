#!/usr/bin/env bash

set -e

if [ -z ${VIRTUAL_ENV+x} ]
then
  ACTIVATE_SCRIPT="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )/.env/bin/activate"
  if [ -f "$ACTIVATE_SCRIPT" ]
  then
    # shellcheck source=/dev/null
    source "$ACTIVATE_SCRIPT"
  else
    echo "$ACTIVATE_SCRIPT not found.  Did you follow documentation to install dependencies?"
    exit 1
  fi
fi

case "$1" in
  update-users) PLAYBOOK=users.yml; ARGS=( "${@:2}"  -t update-users ) ;;
  *) PLAYBOOK=main.yml; ARGS=( "${@}" ) ;;
esac

ansible-playbook ${PLAYBOOK} "${ARGS[@]}"

# Stream the generated client configs back over stdout so a caller driving this
# script over SSH can capture them from the same session, without a separate
# scp/pull step afterward. Only applies to a fresh install (main.yml), and only
# when deploying to localhost, since that's the only case with a predictable
# `configs/localhost` symlink to find the output directory by.
if [ "$PLAYBOOK" = "main.yml" ]; then
  REPO_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
  CONFIGS_LINK="$REPO_DIR/configs/localhost"
  if [ -L "$CONFIGS_LINK" ]; then
    CONFIG_DIR="$(readlink "$CONFIGS_LINK")"
    echo "===ALGO_CONFIGS_BEGIN:${CONFIG_DIR}==="
    tar czf - -C "$REPO_DIR/configs" "$CONFIG_DIR" | base64
    echo "===ALGO_CONFIGS_END==="
  fi
fi
